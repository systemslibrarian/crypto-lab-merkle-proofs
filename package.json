{
  "name": "crypto-lab-merkle-proofs",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive Merkle tree demo — build trees, generate inclusion proofs, and verify them with real SHA-256 (RFC 6962 domain separation). No backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "deploy": "vite build && gh-pages -d dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
}
